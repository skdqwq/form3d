# Copy to .env. Keep the login code and signing secret independent and private.
APP_ORIGIN=http://127.0.0.1:3103
HOST=127.0.0.1
PORT=3103
DATABASE_PATH=./data/form3d.sqlite
# 10–512 characters, including letters and digits; no controls or surrounding whitespace.
FORM3D_ACCESS_TOKEN=replace-with-a-private-login-code
# At least 32 random characters; never shorten this to match the login code.
SESSION_SECRET=replace-with-a-different-random-secret
# Server-side only. Leaving this empty disables paid generation.
MESHY_API_KEY=
# global: api.meshy.ai (default); cn: official api.meshy.cn.
# Existing successful tasks need an explicit administrator asset refresh when switching.
MESHY_REGION=global
